rules_version = '2';

// Reglas de Storage — Mueblería Jose
// Solo se usa la carpeta yape/ (capturas del pago con Yape en las ventas).
// Publicar en la consola → Storage → Reglas (no está en firebase.json para no fallar si Storage no está activo).
service firebase.storage {
  match /b/{bucket}/o {
    match /yape/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
