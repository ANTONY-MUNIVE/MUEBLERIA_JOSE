# Copie este archivo como .env y complete los valores (el .env no se sube al repositorio).

# Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web)
# Clave web del proyecto de Firebase
VITE_API_KEY=
# Dominio de Firebase Auth (inicio de sesión)
VITE_AUTH_DOMAIN=
# ID del proyecto de Firebase (Firestore)
VITE_PROJECT_ID=
# Bucket de Firebase Storage
VITE_STORAGE_BUCKET=
# ID del remitente de Firebase Cloud Messaging
VITE_MESSAGING_SENDER_ID=
# ID de la app web de Firebase
VITE_APP_ID=

# Clave de OpenRouter para el chatbot de la tienda y el diagnóstico con IA del Dashboard
VITE_GEMINI_API_KEY=

# Clave de Google Maps: mapa de Contacto y botón «Obtener dirección» en Nosotros (Geocoding)
VITE_GOOGLE_MAPS_KEY=
